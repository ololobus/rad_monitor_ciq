<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <strings>
        <string id="AppName">RadMonitor Field</string>
        <string id="AppNameBeta">RadMonitor Field Beta</string>
        <string id="DisplayCps">Display CPS instead of µSv/h</string>
        <string id="DoseChart">Radiation dose rate, muSv/h</string>
        <string id="DoseLabel">Dose rate</string>
        <string id="DoseUnits">µSv/h</string>
        <string id="CpsChart">Radiation count rate, CPS</string>
        <string id="CpsLabel">Count rate</string>
        <string id="CpsUnits">CPS</string>
    </strings>

    <properties>
        <property id="ShowCps" type="boolean">false</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.ShowCps" title="@Strings.DisplayCps">
            <settingConfig type="boolean" />
        </setting>
    </settings>

    <fitContributions>
        <fitField id="0" displayInChart="true" sortOrder="0" precision="3"
            chartTitle="@Strings.DoseChart" dataLabel="@Strings.DoseLabel"
            unitLabel="@Strings.DoseUnits" fillColor="#F5A623" />
        <fitField id="1" displayInChart="true" sortOrder="1" precision="1"
            chartTitle="@Strings.CpsChart" dataLabel="@Strings.CpsLabel"
            unitLabel="@Strings.CpsUnits" fillColor="#4A90E2" />
    </fitContributions>
</resources>
